# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys or DB credentials.

# --- LLM ---
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# --- Embeddings ---
# "local"  -> sentence-transformers, free, runs on your machine
# "openai" -> OpenAI embeddings API, costs money, generally better quality
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=study_guide_chunks

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=study_guide_generator

# --- Chunking (ingestion) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval / Agent ---
RETRIEVAL_TOP_K=5
MAX_RETRIEVAL_RETRIES=2
MAX_QUALITY_RETRIES=1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_BASE_URL=http://localhost:8000
